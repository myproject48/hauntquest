<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied while the process starts; removed when Flutter draws
         its first frame. Dark in both light and dark system modes. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Window color behind the Flutter UI while it initializes. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/manor_midnight</item>
    </style>
</resources>
